<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transport layer: 127.0.0.1 TCP listener, token auth, session, operation queue.
    net8.0 (NOT -windows): NO AutoCAD dependency, fully unit-testable off-box.
    This layer NEVER calls the AutoCAD API; it only enqueues work.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TianzhengCadPlugin.Transport</AssemblyName>
    <RootNamespace>TianzhengCadPlugin.Transport</RootNamespace>
    <Version>$(PluginVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianzhengCadPlugin.Protocol\TianzhengCadPlugin.Protocol.csproj" />
  </ItemGroup>

</Project>

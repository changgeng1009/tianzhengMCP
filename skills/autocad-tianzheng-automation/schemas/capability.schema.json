{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autocad-tianzheng/capability.schema.json",
  "title": "能力矩阵",
  "$defs": {
    "supportLevel": {"enum": ["IMPLEMENTED", "IMPLEMENTED_BASELINE", "AVAILABLE_SANDBOX_MVP", "PARTIALLY_IMPLEMENTED", "INTERFACE_ONLY", "DISABLED_CONTRACT_ONLY", "NOT_IMPLEMENTED", "UNSAFE"]},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "support_level", "read_supported", "write_supported", "verification_level", "approval_required", "known_limitations", "evidence"],
      "properties": {
        "capability": {"type": "string"}, "support_level": {"$ref": "#/$defs/supportLevel"},
        "read_supported": {"type": "boolean"}, "write_supported": {"type": "boolean"},
        "verification_level": {"type": "string"}, "approval_required": {"type": "string"},
        "known_limitations": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "productMatrix": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_mode", "product", "backend", "capabilities"],
      "properties": {
        "runtime_mode": {"enum": ["plain_autocad", "tianzheng_water", "tianzheng_hvac"]},
        "product": {"enum": ["autocad", "tianzheng_water", "tianzheng_hvac"]},
        "backend": {"type": "string"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}}
      }
    },
    "securityFinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "closure_claim_allowed"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["OPEN", "CLOSED"]},
        "closure_claim_allowed": {"type": "boolean"},
        "baseline_id": {"type": "string", "minLength": 1},
        "baseline_sha256": {"type": "string", "minLength": 1},
        "parent_baseline_id": {"type": "string", "minLength": 1},
        "parent_baseline_sha256": {"type": "string", "minLength": 1},
        "triggering_change": {"type": "string", "minLength": 1},
        "baseline_path": {"type": "string", "minLength": 1},
        "default_test_real_dwg_access_count": {"type": "integer", "minimum": 0},
        "verifier": {"type": "string", "minLength": 1, "pattern": "^python -m scripts\\.verify_safe_test_baseline\\b"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "CLOSED"}}, "required": ["status"]},
          "then": {"required": ["baseline_id", "baseline_sha256", "parent_baseline_id", "parent_baseline_sha256", "triggering_change", "baseline_path", "default_test_real_dwg_access_count", "verifier"]}
        }
      ]
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "support_level", "available", "execution_allowed", "notes"],
      "properties": {
        "backend": {"type": "string"}, "component": {"type": "string"},
        "support_level": {"$ref": "#/$defs/supportLevel"}, "control_plane_status": {"$ref": "#/$defs/supportLevel"}, "available": {"type": "boolean"},
        "execution_allowed": {"type": "boolean"}, "notes": {"type": "string"}
      }
    },
    "backendMatrix": {
      "type": "object", "additionalProperties": false,
      "required": ["production_d1_allowed", "security_findings", "backends"],
      "properties": {
        "production_d1_allowed": {"const": false},
        "security_findings": {"type": "array", "items": {"$ref": "#/$defs/securityFinding"}},
        "backends": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/backend"}}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/productMatrix"}, {"$ref": "#/$defs/backendMatrix"}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autocad-tianzheng/project_manifest.schema.json",
  "title": "AutoCAD 与天正自动化项目 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "project_name", "task_type", "runtime_mode", "product", "workflow", "approval_level", "production_allowed", "preferred_backend", "visual_review_required", "engineering_review_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "enum": ["inspect_drawing", "analyze_reference", "redraw_from_reference", "align_drawings", "compare_drawings", "sandbox_edit", "verify_output", "visual_review", "missing_detection", "resume_job"]},
    "runtime_mode": {"enum": ["plain_autocad", "tianzheng_water", "tianzheng_hvac", "auto_detect", "offline_analysis"]},
    "product": {"enum": ["autocad", "tianzheng_water", "tianzheng_hvac", "offline", "auto"]},
    "reference_documents": {"type": "array", "items": {"$ref": "#/$defs/document"}, "default": []},
    "target_documents": {"type": "array", "items": {"$ref": "#/$defs/document"}, "default": []},
    "output_root": {"type": "string"},
    "artifact_root": {"type": "string"},
    "document_identities": {"type": "array", "items": {"$ref": "#/$defs/documentIdentity"}, "default": []},
    "expected_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}},
    "input_roles": {"type": "object", "additionalProperties": {"type": "string"}},
    "reference_types": {"type": "array", "items": {"enum": ["DWG", "DXF", "PDF", "PNG", "JPG"]}, "uniqueItems": true},
    "workflow": {"enum": ["00_select_runtime", "01_inspect", "02_reference_analysis", "03_alignment", "04_redraw", "05_missing_detection", "06_sandbox_completion", "07_persistence_verification", "08_visual_review", "09_manual_save_required", "10_failure_recovery"]},
    "approval_level": {"enum": ["L0_READ_ONLY", "L1_DRY_RUN", "L2_SANDBOX_PREP", "L3_SANDBOX_WRITE", "L4_CONTROLLED_PRODUCTION"]},
    "approval": {"$ref": "#/$defs/approval"},
    "production_allowed": {"const": false, "description": "本版本固定为 false；L4 未来需单次外部授权。"},
    "production_d1_allowed": {"const": false, "default": false},
    "protected_regions": {"type": "array", "items": {"$ref": "#/$defs/protectedRegion"}, "default": []},
    "excluded_layers": {"type": "array", "items": {"type": "string"}, "default": []},
    "excluded_objects": {"type": "array", "items": {"type": "string"}, "default": []},
    "preferred_backend": {"enum": ["offline", "original-redraw-adapter", "nextgen-mock", "legacy-contract-disabled", "legacy-com", "nextgen-real", "autocad-dotnet-plugin", "tianzheng-water-real", "tianzheng-hvac-real"]},
    "fallback_backend": {"enum": ["offline", "original-redraw-adapter", "nextgen-mock", "legacy-contract-disabled"]},
    "visual_review_required": {"type": "boolean"},
    "engineering_review_required": {"type": "boolean"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "options": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "document": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "path"],
      "properties": {"id": {"type": "string"}, "type": {"enum": ["DWG", "DXF", "PDF", "PNG", "JPG"]}, "path": {"type": "string"}, "role": {"type": "string"}, "read_only": {"type": "boolean", "default": true}}
    },
    "documentIdentity": {
      "type": "object", "additionalProperties": false, "required": ["document_id", "identity", "sha256"],
      "properties": {"document_id": {"type": "string"}, "identity": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "is_source": {"type": "boolean"}}
    },
    "protectedRegion": {
      "type": "object", "additionalProperties": false, "required": ["id", "rule"],
      "properties": {"id": {"type": "string"}, "rule": {"enum": ["NO_WRITE", "REVIEW_ONLY"]}, "geometry": {"type": "object"}}
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "document_identity", "document_sha256", "plan_hash", "allowed_operations", "runtime_mode", "product", "single_use", "expires_at"],
      "properties": {
        "job_id": {"type": "string"}, "document_identity": {"type": "string"},
        "document_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "plan_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "allowed_operations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "runtime_mode": {"type": "string"}, "product": {"type": "string"},
        "single_use": {"const": true}, "expires_at": {"type": "string", "format": "date-time"},
        "consumed": {"type": "boolean", "default": false}, "production_allowed": {"type": "boolean", "default": false}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "plan_hash", "last_completed_batch_id", "completed_batch_count", "completed_task_count", "journal_mode", "atomic_write", "idempotency_keys", "manual_save_status"],
      "properties": {
        "job_id": {"type": "string"}, "plan_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "last_completed_batch_id": {"type": ["string", "null"]},
        "completed_batch_count": {"type": "integer", "minimum": 0},
        "completed_task_count": {"type": "integer", "minimum": 0},
        "journal_mode": {"const": "append_only"}, "atomic_write": {"const": true},
        "idempotency_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dependency_classification": {"type": "object"}, "unexpected_object_classification": {"type": "object"},
        "duplicate_object_blocking": {"const": true}, "outer_timeout_recoverable": {"type": "boolean"},
        "manual_save_status": {"enum": ["NOT_REQUIRED", "MANUAL_SAVE_REQUIRED", "MANUAL_SAVE_CONFIRMED"]},
        "active_document_identity_verified": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_object.schema.json",
  "title": "Water Supply and Drainage Semantic Object",
  "type": "object",
  "required": ["object_id", "professional_domain", "domain_object_type", "geometry", "confidence", "evidence_ids"],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "professional_domain": {"enum": ["water_supply_and_drainage", "hvac"]},
    "system_type": {"type": ["string", "null"]},
    "domain_object_type": {"type": "string"},
    "cad_object_name": {"type": ["string", "null"]},
    "geometry": {"type": "object"},
    "semantic": {"type": "object"},
    "network": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"professional_domain": {"const": "hvac"}}},
      "then": {"properties": {"semantic": {"properties": {"execution_allowed": {"const": false}}}}}
    }
  ],
  "additionalProperties": true
}
